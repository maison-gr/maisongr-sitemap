{
  "name": "maisongr-sitemap",
  "version": "1.6.0",
  "description": "One sitemap, two readers: the XML search engines need, and a page in your site's own design for people. Detects your stack, finds your pages, dates them from Git.",
  "license": "MIT",
  "author": "Maison GR (https://www.maisongr.com)",
  "homepage": "https://github.com/maison-gr/sitemap#readme",
  "mcpName": "io.github.maison-gr/sitemap",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maison-gr/sitemap.git"
  },
  "bugs": "https://github.com/maison-gr/sitemap/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.9"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "next": [
        "./dist/next.d.ts"
      ],
      "node": [
        "./dist/node.d.ts"
      ],
      "vite": [
        "./dist/vite.d.ts"
      ]
    }
  },
  "bin": {
    "maisongr-sitemap": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "llms.txt",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "sitemap",
    "sitemap.xml",
    "seo",
    "nextjs",
    "astro",
    "sveltekit",
    "nuxt",
    "express",
    "vite",
    "hreflang",
    "lastmod",
    "image-sitemap",
    "video-sitemap",
    "indexnow",
    "xslt",
    "xml-sitemap",
    "sitemap-generator",
    "vite-plugin",
    "llms-txt",
    "mcp",
    "agent-skill"
  ],
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
